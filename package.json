{
  "name": "better-potree",
  "version": "0.1.0",
  "private": true,
  "description": "A modern, modular WebGL point cloud viewer based on Potree",
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"!@better-potree/playground\" build",
    "dev": "pnpm --filter @better-potree/playground dev",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --write .",
    "docs": "typedoc",
    "clean": "pnpm -r exec rm -rf dist node_modules && rm -rf node_modules"
  },
  "keywords": [
    "potree",
    "point-cloud",
    "webgl",
    "three.js",
    "3d",
    "visualization"
  ],
  "author": "better-potree contributors",
  "license": "BSD-2-Clause",
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "@rsbuild/core": "^1.5.17",
    "@rsbuild/plugin-type-check": "^1.2.4",
    "@types/eventemitter3": "^2.0.4",
    "@types/node": "^24.8.1",
    "@types/three": "~0.180.0",
    "@vitest/browser": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eventemitter3": "^5.0.1",
    "jsdom": "^27.0.1",
    "three": "~0.180.0",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
