{
  "name": "@better-potree/core",
  "version": "0.1.0",
  "description": "Core functionality for better-potree",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "potree",
    "core"
  ],
  "author": "better-potree contributors",
  "license": "BSD-2-Clause",
  "dependencies": {
    "eventemitter3": "^5.0.1",
    "zustand": "^5.0.8"
  },
  "peerDependencies": {
    "three": "~0.180.0"
  },
  "devDependencies": {
    "@types/three": "~0.180.0"
  }
}
