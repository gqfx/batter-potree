{
  "name": "@better-potree/loader-potree",
  "version": "0.1.0",
  "description": "Potree format loader for better-potree",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "potree",
    "loader"
  ],
  "author": "better-potree contributors",
  "license": "BSD-2-Clause",
  "dependencies": {
    "@better-potree/types": "workspace:*",
    "@better-potree/core": "workspace:*"
  }
}
