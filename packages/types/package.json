{
  "name": "@better-potree/types",
  "version": "0.1.0",
  "description": "Shared TypeScript types and interfaces for better-potree",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "potree",
    "types",
    "typescript"
  ],
  "author": "better-potree contributors",
  "license": "BSD-2-Clause"
}
